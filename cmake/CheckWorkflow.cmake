cmake_minimum_required(VERSION 3.25)

if(NOT DEFINED WORKFLOW_FILE OR WORKFLOW_FILE STREQUAL "")
  set(WORKFLOW_FILE "${CMAKE_CURRENT_LIST_DIR}/../.github/workflows/native.yml")
endif()
if(NOT EXISTS "${WORKFLOW_FILE}")
  message(FATAL_ERROR "workflow contract: file does not exist: ${WORKFLOW_FILE}")
endif()

file(READ "${WORKFLOW_FILE}" _workflow_content)
file(STRINGS "${WORKFLOW_FILE}" _workflow_lines)

set(_inside_on FALSE)
set(_inside_jobs FALSE)
set(_trigger_count 0)
set(_job_count 0)
set(_run_count 0)
set(_canonical_run_count 0)
set(_uses_count 0)
set(_checkout_count 0)
set(_runner_count 0)
set(_selected_runner_count 0)
set(_timeout_count 0)
set(_bounded_timeout_count 0)
set(_job_guard_count 0)
set(_activation_guard_count 0)
set(_concurrency_group_count 0)
set(_same_ref_group_count 0)
set(_cancel_count 0)
set(_cancel_enabled_count 0)
set(_credential_setting_count 0)
set(_credentials_disabled_count 0)
set(_expected_checkout_sha "3d3c42e5aac5ba805825da76410c181273ba90b1")
set(_expected_checkout_line
  "        uses: actions/checkout@${_expected_checkout_sha} # v7.0.1")
set(_expected_activation_guard
  "    if: \${{ vars.LIBFUTURO_CI_ACTIVATED == 'true' }}")
set(_expected_concurrency_group
  "  group: \${{ github.workflow }}-\${{ github.ref }}")

foreach(_line IN LISTS _workflow_lines)
  if(_line STREQUAL "on:")
    set(_inside_on TRUE)
  elseif(_inside_on AND _line MATCHES "^[A-Za-z_][A-Za-z0-9_-]*:")
    set(_inside_on FALSE)
  endif()

  set(_trigger_key "")
  if(_inside_on AND _line MATCHES "^  ([A-Za-z0-9_-]+):")
    set(_trigger_key "${CMAKE_MATCH_1}")
  elseif(_inside_on AND _line MATCHES "^  \"([A-Za-z0-9_-]+)\":")
    set(_trigger_key "${CMAKE_MATCH_1}")
  elseif(_inside_on AND _line MATCHES "^  '([A-Za-z0-9_-]+)':")
    set(_trigger_key "${CMAKE_MATCH_1}")
  endif()

  if(NOT _trigger_key STREQUAL "")
    math(EXPR _trigger_count "${_trigger_count} + 1")
    if(NOT _trigger_key STREQUAL "workflow_dispatch")
      message(FATAL_ERROR
        "workflow contract: unexpected trigger '${_trigger_key}'; only workflow_dispatch is allowed")
    endif()
  endif()

  if(_line STREQUAL "jobs:")
    set(_inside_jobs TRUE)
  elseif(_inside_jobs AND _line MATCHES "^[A-Za-z_][A-Za-z0-9_-]*:")
    set(_inside_jobs FALSE)
  endif()

  if(_inside_jobs AND _line MATCHES "^  ([A-Za-z0-9_-]+):[ \t]*$")
    math(EXPR _job_count "${_job_count} + 1")
    if(NOT CMAKE_MATCH_1 STREQUAL "native")
      message(FATAL_ERROR
        "workflow contract: unexpected job '${CMAKE_MATCH_1}'; exactly one native job is required")
    endif()
  endif()

  if(_line MATCHES "^[ ]+run:")
    math(EXPR _run_count "${_run_count} + 1")
    if(_line STREQUAL "        run: ./scripts/check.sh")
      math(EXPR _canonical_run_count "${_canonical_run_count} + 1")
    endif()
  endif()

  if(_line MATCHES "^[ ]+runs-on:")
    math(EXPR _runner_count "${_runner_count} + 1")
    if(_line STREQUAL "    runs-on: macos-15")
      math(EXPR _selected_runner_count "${_selected_runner_count} + 1")
    endif()
  endif()

  if(_line MATCHES "^[ ]+timeout-minutes:")
    math(EXPR _timeout_count "${_timeout_count} + 1")
    if(_line STREQUAL "    timeout-minutes: 20")
      math(EXPR _bounded_timeout_count "${_bounded_timeout_count} + 1")
    endif()
  endif()

  if(_line MATCHES "^[ ]+if:")
    math(EXPR _job_guard_count "${_job_guard_count} + 1")
    if(_line STREQUAL "${_expected_activation_guard}")
      math(EXPR _activation_guard_count "${_activation_guard_count} + 1")
    endif()
  endif()

  if(_line MATCHES "^[ ]+group:")
    math(EXPR _concurrency_group_count "${_concurrency_group_count} + 1")
    if(_line STREQUAL "${_expected_concurrency_group}")
      math(EXPR _same_ref_group_count "${_same_ref_group_count} + 1")
    endif()
  endif()

  if(_line MATCHES "^[ ]+cancel-in-progress:")
    math(EXPR _cancel_count "${_cancel_count} + 1")
    if(_line STREQUAL "  cancel-in-progress: true")
      math(EXPR _cancel_enabled_count "${_cancel_enabled_count} + 1")
    endif()
  endif()

  if(_line MATCHES "^[ ]+persist-credentials:")
    math(EXPR _credential_setting_count "${_credential_setting_count} + 1")
    if(_line STREQUAL "          persist-credentials: false")
      math(EXPR _credentials_disabled_count "${_credentials_disabled_count} + 1")
    endif()
  endif()

  if(_line MATCHES "^[ ]+uses:")
    math(EXPR _uses_count "${_uses_count} + 1")
    if(_line STREQUAL "${_expected_checkout_line}")
      math(EXPR _checkout_count "${_checkout_count} + 1")
    elseif(_line MATCHES "^[ ]+uses: actions/checkout@")
      message(FATAL_ERROR
        "workflow contract: checkout must use the verified full actions/checkout v7.0.1 commit")
    else()
      message(FATAL_ERROR "workflow contract: unexpected external action: ${_line}")
    endif()
  endif()
endforeach()

if(NOT _trigger_count EQUAL 1)
  message(FATAL_ERROR "workflow contract: exactly one manual workflow_dispatch trigger is required")
endif()
if(NOT _job_count EQUAL 1)
  message(FATAL_ERROR "workflow contract: exactly one job is required")
endif()
if(NOT _run_count EQUAL 1 OR NOT _canonical_run_count EQUAL 1)
  message(FATAL_ERROR "workflow contract: the sole run step must be exactly ./scripts/check.sh")
endif()
if(NOT _uses_count EQUAL 1 OR NOT _checkout_count EQUAL 1)
  message(FATAL_ERROR "workflow contract: exactly one verified actions/checkout step is required")
endif()
if(NOT _runner_count EQUAL 1 OR NOT _selected_runner_count EQUAL 1)
  message(FATAL_ERROR "workflow contract: the sole job must run on macos-15 arm64")
endif()
if(NOT _timeout_count EQUAL 1 OR NOT _bounded_timeout_count EQUAL 1)
  message(FATAL_ERROR "workflow contract: the job must have its 20-minute timeout")
endif()
if(NOT _job_guard_count EQUAL 1 OR NOT _activation_guard_count EQUAL 1)
  message(FATAL_ERROR "workflow contract: the job must use the exact activation variable guard")
endif()
if(NOT _concurrency_group_count EQUAL 1 OR NOT _same_ref_group_count EQUAL 1
    OR NOT _cancel_count EQUAL 1 OR NOT _cancel_enabled_count EQUAL 1)
  message(FATAL_ERROR "workflow contract: same-workflow, same-ref cancellation is required")
endif()
if(NOT _credential_setting_count EQUAL 1 OR NOT _credentials_disabled_count EQUAL 1)
  message(FATAL_ERROR "workflow contract: checkout credentials must not persist")
endif()

set(_required_fragments
  "    permissions:\n      contents: read\n    steps:"
)
foreach(_fragment IN LISTS _required_fragments)
  string(FIND "${_workflow_content}" "${_fragment}" _fragment_index)
  if(_fragment_index EQUAL -1)
    message(FATAL_ERROR "workflow contract: required invariant is missing: ${_fragment}")
  endif()
endforeach()

if(_workflow_content MATCHES "contents:[ \t]*write")
  message(FATAL_ERROR "workflow contract: write permission is not allowed")
endif()

message(STATUS
  "workflow contract: manual-only macos-15 arm64 job, read-only checkout, activation guard, and canonical command verified")
